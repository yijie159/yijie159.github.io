<% if (theme.ai_chat && theme.ai_chat.enable) { %>
<div
    id="ai-chat"
    style="--ai-chat-bottom: <%- theme.ai_chat.buttonBottom || '20px' %>"
>
    <div id="ai-chat-panel" class="ai-chat-hidden">
        <div id="ai-chat-header">
            <span id="ai-chat-title"
                ><i class="fa-solid fa-robot"></i>
                <%- theme.ai_chat.title || "DeepSeek AI 助手" %></span
            >
            <div id="ai-chat-actions">
                <button id="ai-chat-clear" aria-label="清空对话" title="清空对话">
                    <i class="fa-solid fa-trash-can"></i>
                </button>
                <button id="ai-chat-close" aria-label="关闭" title="关闭">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div id="ai-chat-messages"></div>
        <div id="ai-chat-input-wrap">
            <textarea
                id="ai-chat-input"
                rows="1"
                placeholder="<%- theme.ai_chat.placeholder || '输入你的问题，回车发送' %>"
            ></textarea>
            <button id="ai-chat-send" aria-label="发送" title="发送">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </div>
    </div>
    <button id="ai-chat-toggle" aria-label="AI 助手" title="AI 助手">
        <i class="fa-solid fa-robot"></i>
    </button>
</div>
<script>
    window.aiChatConfig = <%- JSON.stringify({
        endpoint: theme.ai_chat.endpoint || "/api/chat",
        model: theme.ai_chat.model || "deepseek-chat",
        title: theme.ai_chat.title || "小桃花",
        greeting: theme.ai_chat.greeting || "你好呀！我是小桃花，博客的 AI 小助手。想了解博客里的任何内容都可以问我～",
        placeholder: theme.ai_chat.placeholder || "输入你的问题，回车发送",
        system: theme.ai_chat.system || "你叫「小桃花」，是部署在个人博客上的 AI 助手，回答请使用简体中文，保持简洁、友好、准确。",
        maxHistory: theme.ai_chat.maxHistory || 12,
        apiKey: theme.ai_chat.apiKey || "",
        directApi: theme.ai_chat.directApi || "https://api.deepseek.com/chat/completions",
        searchBlog: theme.ai_chat.searchBlog !== false,
        indexPath: theme.ai_chat.indexPath || "/ai-blog-index.json",
        searchResults: theme.ai_chat.searchResults || 3
    }) %>;
</script>
<script src="<%- url_for("/js/chat.js") %>"></script>
<% } %>
